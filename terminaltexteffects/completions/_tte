_shtab_tte() {
  local context state line curcontext="$curcontext" one_or_more='(*)' remainder='(-)*:' default='*::: :->tte'

  # Add default positional/remainder specs only if none exist, and only once per session
  if (( ! _shtab_tte_defaults_added )); then
    if (( ${_shtab_tte_options[(I)${(q)one_or_more}*]} +          ${_shtab_tte_options[(I)${(q)remainder}*]} +          ${_shtab_tte_options[(I)${(q)default}]} == 0 )); then
      _shtab_tte_options+=(': :_shtab_tte_commands' '*::: :->tte')
    fi
    _shtab_tte_defaults_added=1
  fi
  _arguments -C -s $_shtab_tte_options

  case $state in
    tte)
      words=($line[1] "${words[@]}")
      (( CURRENT += 1 ))
      curcontext="${curcontext%:*:*}:_shtab_tte-$line[1]:"
      case $line[1] in
        beams) _arguments -C -s $_shtab_tte_beams_options ;;
        binarypath) _arguments -C -s $_shtab_tte_binarypath_options ;;
        blackhole) _arguments -C -s $_shtab_tte_blackhole_options ;;
        bouncyballs) _arguments -C -s $_shtab_tte_bouncyballs_options ;;
        bubbles) _arguments -C -s $_shtab_tte_bubbles_options ;;
        burn) _arguments -C -s $_shtab_tte_burn_options ;;
        colorshift) _arguments -C -s $_shtab_tte_colorshift_options ;;
        crumble) _arguments -C -s $_shtab_tte_crumble_options ;;
        decrypt) _arguments -C -s $_shtab_tte_decrypt_options ;;
        dev) _arguments -C -s $_shtab_tte_dev_options ;;
        errorcorrect) _arguments -C -s $_shtab_tte_errorcorrect_options ;;
        expand) _arguments -C -s $_shtab_tte_expand_options ;;
        fireworks) _arguments -C -s $_shtab_tte_fireworks_options ;;
        highlight) _arguments -C -s $_shtab_tte_highlight_options ;;
        laseretch) _arguments -C -s $_shtab_tte_laseretch_options ;;
        matrix) _arguments -C -s $_shtab_tte_matrix_options ;;
        middleout) _arguments -C -s $_shtab_tte_middleout_options ;;
        orbittingvolley) _arguments -C -s $_shtab_tte_orbittingvolley_options ;;
        overflow) _arguments -C -s $_shtab_tte_overflow_options ;;
        pour) _arguments -C -s $_shtab_tte_pour_options ;;
        print) _arguments -C -s $_shtab_tte_print_options ;;
        rain) _arguments -C -s $_shtab_tte_rain_options ;;
        randomsequence) _arguments -C -s $_shtab_tte_randomsequence_options ;;
        rings) _arguments -C -s $_shtab_tte_rings_options ;;
        scattered) _arguments -C -s $_shtab_tte_scattered_options ;;
        slice) _arguments -C -s $_shtab_tte_slice_options ;;
